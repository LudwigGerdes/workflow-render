{
  "name": "workflow-render-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "smoke": "bash scripts/smoke.sh all"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "tsx": "^4.16.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@resvg/resvg-js"
    ],
    "ignoredBuiltDependencies": [
      "cpu-features",
      "isolated-vm",
      "ssh2"
    ]
  },
  "version": "0.1.0"
}
