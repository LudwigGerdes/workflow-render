{
  "name": "workflow-render-assets",
  "version": "0.2.0",
  "private": true,
  "description": "Bundled n8n node icons, descriptions and subtitle templates plus the Inter faces, with offline loaders for workflow-render.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LudwigGerdes/workflow-render.git",
    "directory": "packages/assets"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    },
    "./data/*": "./data/*"
  },
  "scripts": {
    "extract": "tsx scripts/extract.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
