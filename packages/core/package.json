{
  "name": "workflow-render-core",
  "version": "0.1.0",
  "private": true,
  "description": "Pure parse \u2192 layout \u2192 render pipeline that turns n8n workflow or execution JSON into a deterministic SVG. No DOM, no network.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LudwigGerdes/workflow-render.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter workflow-render-assets build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter workflow-render-assets build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "extract-font-metrics": "tsx scripts/extract-font-metrics.mts"
  },
  "dependencies": {
    "workflow-render-assets": "workspace:*",
    "marked": "^14.0.0"
  },
  "devDependencies": {
    "fast-xml-parser": "^4.4.0",
    "n8n-workflow": "2.38.1",
    "opentype.js": "^2.0.0"
  }
}
